<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tlc.live</groupId>
    <artifactId>tlc-live-substrate</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>tlc-live-substrate</name>
    <description>AI-Native 直播场控与百万级并发博弈基座</description>

    <!-- [KEEP] 反应堆模块清单：父工程不声明 modules 的话 mvn 只会构建自身，子模块不会进入构建 -->
    <modules>
        <module>substrate-common</module>
        <module>substrate-gateway</module>
        <module>substrate-risk</module>
        <module>substrate-agent</module>
        <module>substrate-seckill</module>
        <module>substrate-push</module>
        <module>substrate-audit</module>
        <module>substrate-toggle</module>
        <module>substrate-archiver</module>
    </modules>

    <properties>
        <!-- 锁定 2026 年最新技术栈 -->
        <java.version>25</java.version>
        <spring-boot.version>4.1.1</spring-boot.version>

        <!-- [FIX]: 私服暂缺 2026.0.0 GA，暂时降级到 M1 (Milestone 1)。待 GA 版同步至私服后，再将其改回 2026.0.0 -->
        <spring-cloud.version>2026.0.0-M1</spring-cloud.version>

        <spring-ai.version>2.0.1</spring-ai.version>

        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- 开启 Java 25 预览特性以支持未来可能开启的 Valhalla 等孵化特性 -->
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>

        <!-- [KEEP] 显式锁定编码，避免 Windows 平台默认 GBK 影响资源过滤与报告输出 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- [KEEP] 锁定插件版本：enablePreview 属性需 maven-compiler-plugin 3.13.0+ 才生效 -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>

        <!--
          依赖仓库地址：默认 Maven 官方中央仓库。
          需要临时换源时无需改文件，命令行覆盖即可：
            mvn -Dtlc.repo.url=https://xxx/repository/maven-public ...
        -->
        <tlc.repo.url>https://repo.maven.apache.org/maven2</tlc.repo.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4.x BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud 2026.x BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring AI 1.x BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- RocketMQ Spring Boot Starter -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>2.3.1</version>
            </dependency>

            <!-- Project CRaC 依赖 -->
            <dependency>
                <groupId>org.crac</groupId>
                <artifactId>crac</artifactId>
                <version>1.4.0</version>
            </dependency>

            <!-- [KEEP] 内部模块版本托管：gateway / risk / seckill 引用 substrate-common 时不写 version -->
            <dependency>
                <groupId>com.tlc.live</groupId>
                <artifactId>substrate-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      依赖统一走 Maven 官方中央仓库（不再经过内网私服）。
      注意：仓库 id 不能写成 "central"，否则会被 settings.xml 里的 mirrorOf=central
      镜像规则拦截并重新指回私服；这里用 maven-official 绕过镜像，直接连官方源。
      实测官方源可达（HTTPS 200，小 jar 约 135ms），且 2026.0.0-M1 在中央仓库已发布，
      因此不再需要 Spring Milestones 仓库。
    -->
    <repositories>
        <repository>
            <id>maven-official</id>
            <name>Maven Central</name>
            <url>${tlc.repo.url}</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>maven-official-plugins</id>
            <name>Maven Central</name>
            <url>${tlc.repo.url}</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <!-- [KEEP] 子模块声明 spring-boot-maven-plugin 时无需重复写版本号 -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>${maven.compiler.parameters}</parameters>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- [KEEP] 单测运行在预览字节码上时，JVM 必须开启预览开关（enable&#45;preview），否则类加载被拒 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>

            <!-- 静态检查：mvn spotbugs:check（排除清单见根目录 spotbugs-exclude.xml，
                 多模块运行时经 -Dspotbugs.excludeFilterFile=<绝对路径> 传入） -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.6.0</version>
                <configuration>
                    <excludeFilterFile>${project.basedir}/../spotbugs-exclude.xml</excludeFilterFile>
                    <threshold>Medium</threshold>
                    <effort>Max</effort>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
